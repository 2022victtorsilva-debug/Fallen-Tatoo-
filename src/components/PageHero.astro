---
import { url } from '../lib/paths';
interface Props { eyebrow: string; title: string; description: string; }
const { eyebrow, title, description } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    <div class="breadcrumb"><a href={url('/')}>Início</a> <span aria-hidden="true">/</span> {eyebrow}</div>
    <div class="page-hero__grid">
      <div><span class="eyebrow">{eyebrow}</span><h1>{title}</h1></div>
      <p>{description}</p>
    </div>
  </div>
</section>
