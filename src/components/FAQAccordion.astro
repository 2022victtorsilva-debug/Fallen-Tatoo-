---
import { faqs } from '../data/site';
interface Props { limit?: number; }
const items = Astro.props.limit ? faqs.slice(0, Astro.props.limit) : faqs;
---
<div class="faq-list" data-faq>
  {items.map((item, index) => (
    <div class="faq-item">
      <h3>
        <button type="button" aria-expanded="false" aria-controls={`faq-panel-${index}`} id={`faq-button-${index}`}>
          <span>{item.q}</span><span class="faq-icon" aria-hidden="true">+</span>
        </button>
      </h3>
      <div class="faq-panel" id={`faq-panel-${index}`} role="region" aria-labelledby={`faq-button-${index}`} hidden>
        <p>{item.a}</p>
      </div>
    </div>
  ))}
</div>
<script>
  document.querySelectorAll('[data-faq] button').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const panel = document.getElementById(button.getAttribute('aria-controls') || '');
      if (!(panel instanceof HTMLElement)) return;
      const opening = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(opening));
      panel.hidden = false;
      if (opening) {
        panel.style.height = '0px';
        panel.style.opacity = '0';
        requestAnimationFrame(() => {
          panel.style.height = `${panel.scrollHeight}px`;
          panel.style.opacity = '1';
        });
      } else {
        panel.style.height = `${panel.scrollHeight}px`;
        panel.style.opacity = '1';
        requestAnimationFrame(() => {
          panel.style.height = '0px';
          panel.style.opacity = '0';
        });
        window.setTimeout(() => { if (button.getAttribute('aria-expanded') === 'false') panel.hidden = true; }, 290);
      }
    });
  });
</script>
<style>
  .faq-list { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item h3 { margin: 0; font-family: var(--sans); }
  .faq-item button { width: 100%; display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; border: 0; padding: 25px 2px; background: transparent; text-align: left; cursor: pointer; font-size: clamp(1rem, 2vw, 1.2rem); font-weight: 620; line-height: 1.45; }
  .faq-item button:hover { color: var(--gold-bright); }
  .faq-icon { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--line); border-radius: 50%; font-size: 1.2rem; transition: transform 250ms var(--ease), border-color 250ms ease; }
  button[aria-expanded='true'] .faq-icon { transform: rotate(45deg); border-color: var(--gold); }
  .faq-panel { height: 0; overflow: hidden; opacity: 0; transition: height 380ms var(--ease), opacity 220ms ease; }
  .faq-panel p { max-width: 780px; padding: 0 54px 26px 2px; color: var(--muted); }
  @media (max-width: 640px) { .faq-item button { padding-block: 21px; } .faq-panel p { padding-right: 8px; } }
</style>
