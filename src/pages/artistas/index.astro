---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { url } from '../../lib/paths';
---
<BaseLayout title="Artistas" description="Conheça Vinícius Medrado e Thiago Peil, os artistas apresentados pela Fallen Tattoo Studio em Salvador.">
  <PageHero eyebrow="Artistas" title="Conheça os artistas da Fallen." description="Veja as páginas de Vinícius Medrado e Thiago Peil e conheça os trabalhos apresentados no estúdio." />
  <section class="section">
    <div class="wrap artist-list">
      <a class="artist-feature" href={url('/artistas/vinicius-medrado/')} data-reveal>
        <img src={url('/images/11-artist-vinicius-machine-portrait.webp')} alt="Vinícius Medrado segurando uma máquina de tatuagem" width="1235" height="1536" />
        <div><span class="eyebrow">Vinícius Medrado</span><h2>Retratos e trabalhos.</h2><p>Veja a seleção de tatuagens e o Instagram do artista.</p><em>Ver página do artista</em></div>
      </a>
      <a class="artist-feature artist-feature--reverse artist-feature--collage" href={url('/artistas/thiago-peil/')} data-reveal>
        <img src={url('/images/13-artist-thiago-collage.webp')} alt="Colagem com retrato e trabalhos de Thiago Peil" width="1536" height="1536" loading="lazy" decoding="async" />
        <div><span class="eyebrow">Thiago Peil</span><h2>Desenhos e tatuagens.</h2><p>Conheça os trabalhos reunidos por Thiago e fale com a Fallen.</p><em>Ver página do artista</em></div>
      </a>
    </div>
  </section>
  <section class="section section--line"><div class="wrap"><CtaBand title="Leve sua referência para a conversa." /></div></section>
</BaseLayout>
<style>
  .artist-list { display: grid; gap: 30px; }
  .artist-feature { min-height: 520px; display: grid; grid-template-columns: 1.15fr .85fr; overflow: hidden; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); transition: transform .3s var(--ease), border-color .3s ease; }
  .artist-feature:hover { transform: translateY(-6px); border-color: rgba(211,179,124,.45); }
  .artist-feature img { width: 100%; height: 100%; object-fit: cover; }
  .artist-feature--collage img { object-fit: contain; background: #090909; }
  .artist-feature div { display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(30px, 6vw, 72px); }
  .artist-feature p { margin: 22px 0; color: var(--muted); }
  .artist-feature em { color: var(--gold-bright); font-style: normal; font-weight: 700; }
  .artist-feature--reverse img { order: 2; }
  @media (max-width: 760px) { .artist-feature { grid-template-columns: 1fr; min-height: 0; } .artist-feature img { max-height: 390px; aspect-ratio: 4 / 3; object-position: center 32%; } .artist-feature--reverse img { order: initial; } .artist-feature--collage img { max-height: none; aspect-ratio: 1; object-fit: contain; } }
</style>
