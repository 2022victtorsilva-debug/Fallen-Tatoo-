---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { url } from '../../lib/paths';
---
<BaseLayout title="Artistas" description="Conheça Vinícius Medrado e Thiago Peil, os artistas apresentados pela Fallen Tattoo Studio em Salvador.">
  <PageHero eyebrow="Artistas" title="Dois artistas. Trabalhos que falam por si." description="As páginas individuais usam apenas os materiais confirmados para cada artista — sem biografias inventadas ou especialidades atribuídas sem fonte." />
  <section class="section">
    <div class="wrap artist-list">
      <a class="artist-feature" href={url('/artistas/vinicius-medrado/')} data-reveal>
        <img src={url('/images/11-artist-vinicius-machine-portrait.webp')} alt="Vinícius Medrado segurando uma máquina de tatuagem" width="1235" height="1536" />
        <div><span class="eyebrow">Vinícius Medrado</span><h2>O instrumento em primeiro plano.</h2><p>Retrato, composições editoriais e uma seleção de tattoos do portfólio.</p><em>Conhecer trabalhos ↗</em></div>
      </a>
      <a class="artist-feature artist-feature--reverse" href={url('/artistas/thiago-peil/')} data-reveal>
        <img src={url('/images/13-artist-thiago-collage.webp')} alt="Colagem com retrato e trabalhos de Thiago Peil" width="1536" height="1536" loading="lazy" />
        <div><span class="eyebrow">Thiago Peil</span><h2>Uma colagem de referências e trabalhos.</h2><p>Uma apresentação visual concentrada no material confirmado para o artista.</p><em>Conhecer trabalhos ↗</em></div>
      </a>
    </div>
  </section>
  <section class="section section--line"><div class="wrap"><CtaBand title="Leve sua referência para a conversa." /></div></section>
</BaseLayout>
<style>
  .artist-list { display: grid; gap: 30px; }
  .artist-feature { min-height: 650px; display: grid; grid-template-columns: 1.15fr .85fr; overflow: hidden; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); transition: transform .3s var(--ease), border-color .3s ease; }
  .artist-feature:hover { transform: translateY(-6px); border-color: rgba(211,179,124,.45); }
  .artist-feature img { width: 100%; height: 100%; object-fit: cover; }
  .artist-feature div { display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(30px, 6vw, 72px); }
  .artist-feature p { margin: 22px 0; color: var(--muted); }
  .artist-feature em { color: var(--gold-bright); font-style: normal; font-weight: 700; }
  .artist-feature--reverse img { order: 2; }
  @media (max-width: 760px) { .artist-feature { grid-template-columns: 1fr; min-height: 0; } .artist-feature img { aspect-ratio: 4 / 5; } .artist-feature--reverse img { order: initial; } }
</style>
