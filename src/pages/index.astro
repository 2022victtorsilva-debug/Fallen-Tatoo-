---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CtaBand from '../components/CtaBand.astro';
import { portfolio, services, styles, studio } from '../data/site';
import { url } from '../lib/paths';
---
<BaseLayout title="Fallen Tattoo Studio" description="Estúdio de tatuagem no Centro Histórico de Salvador. Projetos personalizados, portfólio, artistas, serviços e orçamento pelo WhatsApp.">
  <section class="home-hero">
    <div class="hero-visual" aria-hidden="true">
      <img src={url('/images/02-hero-tattoo-owl.png')} width="1229" height="1536" alt="" fetchpriority="high" />
    </div>
    <div class="hero-shade"></div>
    <div class="hero-content wrap">
      <div class="hero-copy">
        <span class="eyebrow">Tatuagem em Salvador</span>
        <h1><span>Traço, presença</span><span>e intenção.</span></h1>
        <p>Projetos personalizados, diferentes linguagens visuais e dois artistas reunidos no Centro Histórico.</p>
        <div class="button-row"><a class="button" href={studio.whatsapp} target="_blank" rel="noreferrer">Solicitar orçamento</a><a class="button button--ghost" href={url('/portfolio/')}>Ver portfólio</a></div>
      </div>
      <div class="hero-index"><span>Fallen Tattoo Studio</span><span>Salvador — Bahia</span></div>
    </div>
  </section>

  <section class="section intro-section">
    <div class="wrap intro-grid" data-reveal>
      <div><span class="eyebrow">O estúdio</span><h2>O projeto certo para a pele, não para um molde.</h2></div>
      <div><p class="lede">A Fallen Tattoo Studio atende em Salvador com projetos personalizados e uma seleção de trabalhos que atravessa diferentes estilos.</p><p class="muted">Vinícius Medrado e Thiago Peil são os artistas apresentados no site. Conheça as imagens, referências e caminhos de cada trabalho antes de solicitar seu orçamento.</p><a class="text-link" href={url('/artistas/')}>Conhecer os artistas</a></div>
    </div>
  </section>

  <section class="section section--line">
    <div class="wrap">
      <div class="section-header" data-reveal><div><span class="eyebrow">Serviços</span><h2>Do novo projeto ao retrabalho.</h2></div><p>A avaliação começa pela ideia, pela pele e pelo que já existe. Sem tabela genérica: cada orçamento considera o projeto.</p></div>
      <div class="home-service-grid">
        {services.slice(0,3).map((service, index) => (
          <article class="service-row" data-reveal>
            <span>0{index + 1}</span><div><h3>{service.title}</h3><p>{service.text}</p></div><img src={service.image.src} alt={service.image.alt} width={service.image.width} height={service.image.height} loading="lazy" />
          </article>
        ))}
      </div>
      <a class="button button--ghost section-action" href={url('/servicos/')}>Ver todos os serviços</a>
    </div>
  </section>

  <section class="section styles-preview">
    <div class="wrap">
      <div class="section-header" data-reveal><div><span class="eyebrow">Estilos no portfólio</span><h2>Uma seleção feita para olhar de perto.</h2></div><p>Não são rótulos fixos para os artistas. São linguagens que aparecem nos trabalhos reunidos pela Fallen.</p></div>
      <div class="card-grid">
        {styles.slice(0,3).map((style) => (
          <article class="card" data-reveal><div class="card__image"><img src={style.image.src} alt={style.image.alt} width={style.image.width} height={style.image.height} loading="lazy" /></div><div class="card__body"><h3>{style.title}</h3><p>{style.text}</p></div></article>
        ))}
      </div>
      <a class="button button--ghost section-action" href={url('/estilos/')}>Explorar estilos</a>
    </div>
  </section>

  <section class="section section--line artists-preview">
    <div class="wrap">
      <div class="section-header" data-reveal><div><span class="eyebrow">Artistas</span><h2>Duas assinaturas visuais.</h2></div><p>Veja as páginas individuais e os materiais confirmados de cada artista.</p></div>
      <div class="artist-pair">
        <a class="artist-card card" href={url('/artistas/vinicius-medrado/')} data-reveal><img src={url('/images/11-artist-vinicius-machine-portrait.webp')} alt="Vinícius Medrado segurando uma máquina de tatuagem" width="1235" height="1536" loading="lazy" /><div><span>Artista</span><h3>Vinícius Medrado</h3><em>Conhecer trabalhos ↗</em></div></a>
        <a class="artist-card card" href={url('/artistas/thiago-peil/')} data-reveal><img src={url('/images/13-artist-thiago-collage.webp')} alt="Colagem de trabalhos e retrato de Thiago Peil" width="1536" height="1536" loading="lazy" /><div><span>Artista</span><h3>Thiago Peil</h3><em>Conhecer trabalhos ↗</em></div></a>
      </div>
    </div>
  </section>

  <section class="section portfolio-preview">
    <div class="wrap">
      <div class="section-header" data-reveal><div><span class="eyebrow">Portfólio</span><h2>A tattoo ocupa a cena.</h2></div><p>Trabalhos reais do pacote fornecido para o projeto, sem imagens geradas ou alterações na arte.</p></div>
      <div class="editorial-grid">
        {portfolio.slice(1,7).map((item, index) => <a href={url('/portfolio/')} class={`editorial-grid__item item-${index + 1}`} data-reveal><img src={item.src} alt={item.alt} width={item.width} height={item.height} loading="lazy" /><span>{item.style}</span></a>)}
      </div>
      <a class="button section-action" href={url('/portfolio/')}>Ver portfólio completo</a>
    </div>
  </section>

  <section class="section studio-split section--line">
    <div class="wrap studio-grid">
      <div class="studio-image" data-reveal><img src={url('/images/14-studio-interior-fallen.webp')} alt="Interior da Fallen Tattoo Studio com maca, sofá e símbolo da marca" width="1536" height="1536" loading="lazy" /></div>
      <div class="studio-copy" data-reveal><span class="eyebrow">Fallen por dentro</span><h2>Um espaço no Centro Histórico.</h2><p class="lede">A Fallen atende no Ed. Santa Cruz, na Rua do Tesouro.</p><p class="muted">Veja a localização, abra a rota no Google Maps ou converse com a equipe pelo WhatsApp antes da visita.</p><address>{studio.address}</address><div class="button-row"><a class="button" href={studio.maps} target="_blank" rel="noreferrer">Abrir no Maps</a><a class="button button--ghost" href={url('/contato/')}>Ver contato</a></div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-home-grid"><div data-reveal><span class="eyebrow">Antes da sessão</span><h2>Dúvidas frequentes.</h2><p class="muted">Cuidados, cicatrização, tamanho e orçamento reunidos em respostas diretas.</p><a class="text-link" href={url('/faq/')}>Ver todas as dúvidas</a></div><div data-reveal><FAQAccordion limit={5} /></div></div>
  </section>

  <section class="section section--line">
    <div class="wrap location-grid">
      <div data-reveal><span class="eyebrow">Localização</span><h2>No coração de Salvador.</h2><p class="lede">{studio.address}</p><div class="button-row"><a class="button" href={studio.maps} target="_blank" rel="noreferrer">Traçar rota</a><a class="button button--ghost" href={studio.whatsapp} target="_blank" rel="noreferrer">WhatsApp</a></div></div>
      <iframe title="Mapa da Fallen Tattoo Studio" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Ed.%20Santa%20Cruz%20Rua%20do%20Tesouro%2056%20Salvador%20BA&output=embed"></iframe>
    </div>
  </section>

  <section class="section"><div class="wrap"><CtaBand /></div></section>
</BaseLayout>

<style>
  .home-hero { position: relative; min-height: min(900px, calc(100svh - 74px)); display: flex; align-items: flex-end; overflow: hidden; background: #080808; }
  .hero-visual { position: absolute; inset: 0 0 0 42%; overflow: hidden; clip-path: inset(0 100% 0 0); animation: hero-reveal .9s .08s var(--ease) forwards; }
  .hero-visual img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; filter: saturate(.8) contrast(1.05); }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, #070707 0%, rgba(7,7,7,.96) 33%, rgba(7,7,7,.35) 66%, rgba(7,7,7,.15)), linear-gradient(0deg, rgba(7,7,7,.7), transparent 35%); }
  .hero-content { position: relative; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 40px; padding-block: clamp(90px, 12vh, 150px) 40px; }
  .hero-copy { max-width: 800px; }
  .hero-copy .eyebrow { opacity: 0; animation: rise .45s .3s var(--ease) forwards; }
  .hero-copy h1 { max-width: 820px; }
  .hero-copy h1 span { display: block; overflow: hidden; opacity: 0; transform: translateY(45px); animation: title-line .62s var(--ease) forwards; }
  .hero-copy h1 span:nth-child(1) { animation-delay: .34s; }
  .hero-copy h1 span:nth-child(2) { animation-delay: .43s; color: var(--gold-bright); font-style: italic; }
  .hero-copy p { max-width: 580px; margin: 28px 0 30px; color: #c8c1b8; font-size: clamp(1rem, 1.8vw, 1.25rem); opacity: 0; animation: rise .42s .65s var(--ease) forwards; }
  .hero-copy .button-row { opacity: 0; animation: rise .35s .79s var(--ease) forwards; }
  .hero-index { display: flex; writing-mode: vertical-rl; gap: 30px; color: rgba(255,255,255,.5); font-size: .68rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  @keyframes hero-reveal { to { clip-path: inset(0); } }
  @keyframes title-line { to { opacity: 1; transform: translateY(0); } }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .intro-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(50px, 10vw, 140px); align-items: start; }
  .section-action { margin-top: 38px; }
  .home-service-grid { border-top: 1px solid var(--line); }
  .service-row { display: grid; grid-template-columns: 70px 1fr 150px; align-items: center; gap: 28px; min-height: 190px; border-bottom: 1px solid var(--line); }
  .service-row > span { color: var(--gold-bright); font-family: var(--serif); font-size: 1.1rem; }
  .service-row p { margin: 8px 0 0; max-width: 650px; color: var(--muted); }
  .service-row img { width: 150px; height: 150px; border-radius: 12px; object-fit: cover; filter: grayscale(.4); transition: filter .3s ease, transform .3s var(--ease); }
  .service-row:hover img { filter: none; transform: scale(1.025); }
  .styles-preview { background: linear-gradient(180deg, rgba(255,255,255,.018), transparent); }
  .artist-pair { display: grid; grid-template-columns: 1.12fr .88fr; gap: 24px; }
  .artist-card { min-height: 630px; }
  .artist-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .artist-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.9), transparent 55%); }
  .artist-card div { position: absolute; z-index: 2; inset: auto 0 0; padding: 34px; }
  .artist-card span { color: var(--gold-bright); font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .artist-card h3 { margin: 8px 0 14px; font-size: clamp(2.1rem, 4vw, 3.8rem); }
  .artist-card em { font-style: normal; color: #d7d1c8; font-size: .88rem; }
  .editorial-grid { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: 90px; gap: 16px; }
  .editorial-grid__item { position: relative; overflow: hidden; border-radius: 16px; }
  .editorial-grid__item img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s var(--ease); }
  .editorial-grid__item:hover img { transform: scale(1.035); }
  .editorial-grid__item span { position: absolute; left: 16px; bottom: 16px; padding: 6px 10px; border-radius: 999px; background: rgba(5,5,5,.78); backdrop-filter: blur(8px); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .item-1 { grid-column: 1 / 6; grid-row: span 6; } .item-2 { grid-column: 6 / 10; grid-row: span 4; } .item-3 { grid-column: 10 / 13; grid-row: span 5; } .item-4 { grid-column: 6 / 10; grid-row: span 5; } .item-5 { grid-column: 10 / 13; grid-row: span 4; } .item-6 { grid-column: 1 / 6; grid-row: span 4; }
  .studio-grid { display: grid; grid-template-columns: 1.08fr .92fr; gap: clamp(42px, 8vw, 110px); align-items: center; }
  .studio-image { border-radius: 18px; overflow: hidden; }
  .studio-image img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .studio-copy address { margin: 28px 0; padding-left: 18px; border-left: 1px solid var(--gold); color: #d4cec5; font-style: normal; }
  .faq-home-grid { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(48px, 10vw, 140px); }
  .location-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(40px, 7vw, 90px); align-items: center; }
  .location-grid iframe { width: 100%; min-height: 440px; border: 0; border-radius: 18px; filter: grayscale(1) invert(.9) contrast(.85); }
  @media (max-width: 900px) { .hero-visual { inset-left: 22%; } .hero-content { grid-template-columns: 1fr; } .hero-index { display: none; } .intro-grid, .studio-grid, .faq-home-grid, .location-grid { grid-template-columns: 1fr; } .artist-card { min-height: 540px; } }
  @media (max-width: 640px) { .home-hero { min-height: calc(100svh - 68px); } .hero-visual { inset: 0; opacity: .62; } .hero-shade { background: linear-gradient(0deg, #070707 0%, rgba(7,7,7,.72) 62%, rgba(7,7,7,.18)); } .hero-content { padding-bottom: 44px; } .service-row { grid-template-columns: 44px 1fr; min-height: auto; padding-block: 24px; } .service-row img { display: none; } .artist-pair { grid-template-columns: 1fr; } .artist-card { min-height: 500px; } .editorial-grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 210px; } .editorial-grid__item { grid-column: auto !important; grid-row: auto !important; } .editorial-grid__item:nth-child(3n+1) { grid-column: 1 / -1 !important; } .location-grid iframe { min-height: 360px; } }
</style>
